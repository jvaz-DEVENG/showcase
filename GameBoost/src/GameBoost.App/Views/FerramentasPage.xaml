<UserControl x:Class="GameBoost.App.Views.FerramentasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase">

    <UserControl.Resources>
        <!-- Agrupa por categoria: Interface, Rede, Espaco, Seguranca, Diagnostico. -->
        <CollectionViewSource x:Key="PorCategoria" Source="{Binding Ferramentas}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Categoria" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource TextoSecundario}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Lista de ferramentas -->
            <Border Grid.Column="0" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                    BorderThickness="1" CornerRadius="8">
                <ListBox ItemsSource="{Binding Source={StaticResource PorCategoria}}"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ItemDeAcao}">

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextoSecundario}"
                                               Margin="6,12,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SuperficieAlta}" CornerRadius="6"
                                    Padding="12,10" Margin="4,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />

                                            <Border Background="{StaticResource Borda}" CornerRadius="3"
                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding PrecisaAdmin, Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="admin" FontSize="10"
                                                           Foreground="{StaticResource TextoSecundario}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Descricao}" FontSize="12" Margin="0,3,12,0"
                                                   Foreground="{StaticResource TextoSecundario}" />

                                        <TextBlock Text="{Binding Duracao}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextoDesabilitado}"
                                                   Visibility="{Binding Duracao, Converter={StaticResource TextoParaVisibilidade}}" />
                                    </StackPanel>

                                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="4" Padding="7,2"
                                            VerticalAlignment="Top" Margin="0,1,10,0"
                                            Background="{Binding Risco, Converter={StaticResource RiscoParaCor}}">
                                        <TextBlock Text="{Binding TextoDeRisco}" FontSize="11"
                                                   Foreground="#FF0D1117" FontWeight="SemiBold" />
                                    </Border>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <Button Padding="12,6"
                                                Command="{Binding DataContext.ExecutarCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoBase}">
                                                    <Setter Property="Content" Value="Executar" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rodando}" Value="True">
                                                            <Setter Property="Content" Value="Rodando..." />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="?" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                                                Style="{StaticResource BotaoBase}"
                                                Command="{Binding DataContext.ExplicarCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="O que faz, qual o risco, como desfazer" />
                                    </StackPanel>

                                    <!-- Resultado da ferramenta -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" CornerRadius="4" Padding="9,6"
                                            Margin="0,9,0,0" Background="{StaticResource Superficie}"
                                            Visibility="{Binding TemResultado, Converter={StaticResource BoolParaVisibilidade}}">
                                        <TextBlock Text="{Binding Resultado}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource RiscoBaixo}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Falhou}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource RiscoAlto}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Saida longa: sfc, DISM, teste de disco, informacoes do sistema -->
            <Border Grid.Column="1" Width="420" Margin="12,0,0,0"
                    Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                    BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding TemSaida, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Saída" FontWeight="SemiBold" Margin="16,14,16,8" />

                    <ScrollViewer Grid.Row="1" Margin="12,0,12,0" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding SaidaLonga, Mode=OneWay}" IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextoSecundario}"
                                 FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,10,12,12">
                        <Button Content="Copiar" Style="{StaticResource BotaoBase}" Padding="12,6"
                                Command="{Binding CopiarSaidaCommand}" />
                        <Button Content="Limpar" Style="{StaticResource BotaoBase}" Padding="12,6" Margin="6,0,0,0"
                                Command="{Binding LimparSaidaCommand}" />
                        <Button Content="Cancelar" Style="{StaticResource BotaoBase}" Padding="12,6" Margin="6,0,0,0"
                                Command="{Binding CancelarCommand}"
                                Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource TextoSecundario}"
                   FontSize="12" Margin="0,12,0,0" />
    </Grid>
</UserControl>
