<UserControl x:Class="GameBoost.App.Views.ConfiguracoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource TextoSecundario}" Margin="0,3,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Aba" Padding="16,9" Margin="0,0,4,0" CornerRadius="6"
                                        Background="Transparent">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Aba" Property="Background" Value="{StaticResource Superficie}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Aba" Property="Background" Value="{StaticResource SuperficieAlta}" />
                                        <Setter Property="Foreground" Value="{StaticResource Texto}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Preferencias -->
            <TabItem Header="Preferencias">
                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" Padding="22,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Aparencia" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox Content="Tema escuro" IsChecked="{Binding TemaEscuro}" />
                        <TextBlock Text="O tema claro entra numa fase seguinte; por ora a troca fica registrada nas preferencias."
                                   Foreground="{StaticResource TextoDesabilitado}" FontSize="11" Margin="24,4,0,0" />

                        <Rectangle Height="1" Fill="{StaticResource Borda}" Margin="0,18" />

                        <TextBlock Text="Inicializacao" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox Content="Iniciar o GameBoost com o Windows" IsChecked="{Binding IniciarComWindows}" />
                        <TextBlock Text="Desligado por padrao. Se ligar, o GameBoost aparece na propria lista de Inicializacao que ele gerencia."
                                   Foreground="{StaticResource TextoDesabilitado}" FontSize="11" Margin="24,4,0,0" />

                        <CheckBox Content="Abrir minimizado na bandeja" IsChecked="{Binding IniciarMinimizado}"
                                  IsEnabled="{Binding IniciarComWindows}" Margin="0,10,0,0" />

                <CheckBox Margin="0,14,0,0"
                          Content="Permitir que o GameBoost use a internet"
                          IsChecked="{Binding PermitirAcessoARede}"
                          AutomationProperties.Name="Permitir que o GameBoost use a internet" />

                <TextBlock Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextoSecundario}"
                           Text="Desligado por padrão. Serve só para o teste de velocidade da página Rede, que baixa e envia cerca de 100 MB de bytes aleatórios. O GameBoost não tem telemetria: nada sobre você ou sobre esta máquina sai daqui, com esta opção ligada ou desligada." />

                <CheckBox Margin="0,18,0,0"
                          Content="Mostrar o ícone na bandeja do sistema"
                          IsChecked="{Binding MostrarNaBandeja}"
                          AutomationProperties.Name="Mostrar o icone na bandeja do sistema" />

                <TextBlock Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextoSecundario}"
                           Text="Com o ícone ligado, fechar a janela esconde o GameBoost na bandeja em vez de encerrar. Para sair de vez, clique com o botão direito no ícone e escolha Sair." />

                <CheckBox Margin="0,18,0,0"
                          Content="Reconhecer quando um jogo abre"
                          IsChecked="{Binding DetectarJogosAutomaticamente}"
                          AutomationProperties.Name="Reconhecer quando um jogo abre" />

                <TextBlock Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextoSecundario}"
                           Text="Verifica os processos a cada 2 segundos, numa thread de prioridade baixa. Ao encontrar um jogo, ele pergunta se quer ativar o Modo Game — nunca ativa sozinho, a não ser que o perfil daquele jogo mande. Ao fechar o jogo, tudo é desfeito." />

                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Versão do GameBoost" FontWeight="SemiBold" />

                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextoSecundario}">
                            <Run Text="Você está na versão" />
                            <Run Text="{Binding Versao, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>

                        <TextBlock Text="{Binding EstadoDaAtualizacao}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Foreground="{StaticResource TextoSecundario}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Verificar agora" Style="{StaticResource BotaoBase}"
                                    AutomationProperties.Name="Verificar atualizacao do GameBoost"
                                    Command="{Binding VerificarAtualizacaoCommand}"
                                    IsEnabled="{Binding VerificandoAtualizacao, Converter={StaticResource InverterBool}}" />

                            <Button Content="Instalar e reiniciar" Style="{StaticResource BotaoPrimario}"
                                    Margin="8,0,0,0"
                                    Command="{Binding InstalarAtualizacaoCommand}"
                                    Visibility="{Binding AtualizacaoPronta, Converter={StaticResource BoolParaVisibilidade}}" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextoSecundario}"
                                   Text="A atualização é baixada em segundo plano e só entra quando você mandar, ou no próximo início. O GameBoost nunca troca de versão no meio do que você está fazendo." />
                    </StackPanel>
                </Border>

                        <Rectangle Height="1" Fill="{StaticResource Borda}" Margin="0,18" />

                        <TextBlock Text="Dados" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ModoDeArmazenamento}" Foreground="{StaticResource TextoSecundario}" FontSize="12" />
                        <TextBlock Text="{Binding PastaDeDados}" Foreground="{StaticResource TextoDesabilitado}"
                                   FontSize="11" Margin="0,3,0,0" />
                        <Button Content="Abrir pasta de dados" Style="{StaticResource BotaoBase}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding AbrirPastaDeDadosCommand}" />

                        <Rectangle Height="1" Fill="{StaticResource Borda}" Margin="0,18" />

                        <TextBlock Text="Sem telemetria, sem anuncios, sem conta." FontWeight="SemiBold" />
                        <TextBlock Text="Nada sai desta maquina. O GameBoost nao envia dados de uso para lugar nenhum."
                                   Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Historico -->
            <TabItem Header="Historico">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Toda alteracao de sistema que o GameBoost ja fez, lida do state-backup."
                                   Foreground="{StaticResource TextoSecundario}" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="Recarregar" Style="{StaticResource BotaoBase}" Padding="10,6"
                                HorizontalAlignment="Right" Command="{Binding RecarregarHistoricoCommand}" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ListBox ItemsSource="{Binding Historico}" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" Padding="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource ItemDeAcao}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SuperficieAlta}" CornerRadius="6"
                                                Padding="12,10" Margin="4,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Descricao}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Mudanca}" FontSize="12"
                                                               Foreground="{StaticResource TextoSecundario}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Quando}" FontSize="11"
                                                                   Foreground="{StaticResource TextoDesabilitado}" />
                                                        <TextBlock Text="  ·  " FontSize="11"
                                                                   Foreground="{StaticResource TextoDesabilitado}" />
                                                        <TextBlock Text="{Binding Modulo}" FontSize="11"
                                                                   Foreground="{StaticResource TextoDesabilitado}" />
                                                        <TextBlock Text="  ·  " FontSize="11"
                                                                   Foreground="{StaticResource TextoDesabilitado}" />
                                                        <TextBlock Text="{Binding Tipo}" FontSize="11"
                                                                   Foreground="{StaticResource TextoDesabilitado}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Situacao}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="12,0"
                                                           Foreground="{StaticResource TextoSecundario}" />

                                                <Button Grid.Column="2" Content="Desfazer" Style="{StaticResource BotaoBase}"
                                                        Padding="10,6" IsEnabled="{Binding PodeDesfazer}"
                                                        Command="{Binding DataContext.DesfazerCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Nenhuma alteracao registrada ainda."
                                       Foreground="{StaticResource TextoSecundario}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HistoricoVazio, Converter={StaticResource BoolParaVisibilidade}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource TextoSecundario}"
                   FontSize="12" Margin="0,12,0,0" />
    </Grid>
</UserControl>
