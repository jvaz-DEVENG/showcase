<UserControl x:Class="GameBoost.App.Views.DiagnosticoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GameBoost.App.Controls">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource TextoSecundario}" Margin="0,3,12,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{Binding TemperaturaCpu}" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{StaticResource TextoSecundario}"
                           Visibility="{Binding TemperaturaCpu, Converter={StaticResource TextoParaVisibilidade}}" />

                <Button Content="Iniciar" Style="{StaticResource BotaoPrimario}"
                        Command="{Binding IniciarCommand}"
                        Visibility="{Binding Monitorando, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />

                <Button Content="Parar" Style="{StaticResource BotaoBase}"
                        Command="{Binding PararCommand}"
                        Visibility="{Binding Monitorando, Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </Grid>

        <!-- Cinco medidores com grafico de 60 s -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Medidores}" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Nome}" Foreground="{StaticResource TextoSecundario}" FontSize="12" />
                                <TextBlock Text="{Binding Texto}" HorizontalAlignment="Right"
                                           FontSize="17" FontWeight="Bold" />
                            </Grid>

                            <ctrl:MiniGrafico Height="46" Margin="0,8,0,0"
                                              Valores="{Binding Serie}"
                                              Maximo="{Binding Maximo}"
                                              CorDaLinha="{StaticResource Acento}" />

                            <TextBlock Text="{Binding Detalhe}" Foreground="{StaticResource TextoDesabilitado}"
                                       FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Detalhe}"
                                       Visibility="{Binding Detalhe, Converter={StaticResource TextoParaVisibilidade}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Findings e top 10 processos -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Findings -->
            <Border Grid.Column="0" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="O que encontramos" FontWeight="SemiBold" Margin="16,14,16,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Findings}" Background="Transparent"
                             BorderThickness="0" Padding="10,0,10,10"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ItemDeAcao}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SuperficieAlta}" CornerRadius="6"
                                        Padding="14,11" Margin="0,4" BorderThickness="3,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TextoDeSeveridade}" Value="Critico">
                                                    <Setter Property="BorderBrush" Value="{StaticResource RiscoAlto}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TextoDeSeveridade}" Value="Atencao">
                                                    <Setter Property="BorderBrush" Value="{StaticResource RiscoMedio}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                       Margin="0,0,80,0" />
                                            <TextBlock Text="{Binding TextoDeSeveridade}" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Foreground="{StaticResource TextoDesabilitado}" />
                                        </Grid>

                                        <TextBlock Text="{Binding Detalhe}" Foreground="{StaticResource TextoSecundario}"
                                                   FontSize="12" Margin="0,4,0,0" />

                                        <Button Content="{Binding TextoDaAcao}" Style="{StaticResource BotaoBase}"
                                                Padding="10,5" HorizontalAlignment="Left" Margin="0,9,0,0"
                                                Visibility="{Binding TemAcao, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.ExecutarAcaoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="Nada fora do lugar por enquanto."
                               Foreground="{StaticResource RiscoBaixo}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SemFindings, Converter={StaticResource BoolParaVisibilidade}}" />
                </Grid>
            </Border>

            <!-- Top 10 processos -->
            <Border Grid.Column="1" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Quem mais consome" FontWeight="SemiBold" Margin="16,14,16,8" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProcessos}" Margin="10,0,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding NomeExibido}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" FontSize="12"
                                               Foreground="{StaticResource TextoSecundario}">
                                        <Run Text="{Binding CpuPercent, StringFormat={}{0:0.0}%, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Rodape -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextoSecundario}" FontSize="12" />
            <TextBlock Text="{Binding CustoDaColeta}" Foreground="{StaticResource TextoDesabilitado}"
                       FontSize="11" Margin="0,3,0,0"
                       Visibility="{Binding CustoDaColeta, Converter={StaticResource TextoParaVisibilidade}}" />
        </StackPanel>
    </Grid>
</UserControl>
