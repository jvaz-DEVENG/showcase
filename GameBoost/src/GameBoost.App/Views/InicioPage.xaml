<UserControl x:Class="GameBoost.App.Views.InicioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource TextoSecundario}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Aviso de restauracao pendente -->
        <Border Grid.Row="1" Background="#33D29922" BorderBrush="{StaticResource RiscoMedio}"
                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding AvisoDeRestauracao, Converter={StaticResource TextoParaVisibilidade}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding AvisoDeRestauracao}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Restaurar agora" Style="{StaticResource BotaoBase}"
                        Command="{Binding ReverterTudoCommand}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Pontuacao de saude e principais achados (secoes 5.12 e 5.5) -->
        <Border Grid.Row="2" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Nota -->
                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="31"
                        Background="{StaticResource SuperficieAlta}"
                        BorderBrush="{StaticResource Borda}" BorderThickness="2">
                    <Grid>
                        <TextBlock Text="--" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource TextoDesabilitado}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding PontuacaoDisponivel, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />
                        <TextBlock Text="{Binding NotaGeral}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Acento}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding PontuacaoDisponivel, Converter={StaticResource BoolParaVisibilidade}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Saude do sistema" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Conceito}" Margin="8,0,0,0"
                                   Foreground="{StaticResource Acento}"
                                   Visibility="{Binding PontuacaoDisponivel, Converter={StaticResource BoolParaVisibilidade}}" />
                    </StackPanel>

                    <!-- Antes da analise -->
                    <TextBlock Text="{Binding PontuacaoPlaceholder}"
                               Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,3,0,0"
                               Visibility="{Binding PontuacaoDisponivel, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />

                    <!-- Notas por area -->
                    <ItemsControl ItemsSource="{Binding Areas}" Margin="0,7,0,0"
                                  Visibility="{Binding PontuacaoDisponivel, Converter={StaticResource BoolParaVisibilidade}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Nome}" FontSize="11"
                                               Foreground="{StaticResource TextoSecundario}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,3,0,0">
                                        <Border Background="{StaticResource SuperficieAlta}" CornerRadius="3" Height="6" />
                                        <Border Background="{StaticResource Acento}" CornerRadius="3" Height="6"
                                                HorizontalAlignment="Left"
                                                Width="{Binding Nota}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Nota}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ProgressoDaAnalise}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{StaticResource TextoDesabilitado}"
                               Visibility="{Binding ProgressoDaAnalise, Converter={StaticResource TextoParaVisibilidade}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Analisar" Style="{StaticResource BotaoBase}" Padding="14,7"
                            Command="{Binding AnalisarSaudeCommand}"
                            IsEnabled="{Binding Analisando, Converter={StaticResource InverterBool}}" />
                    <Button Content="Exportar relatorio" Style="{StaticResource BotaoBase}" Padding="14,7" Margin="0,6,0,0"
                            Command="{Binding ExportarRelatorioCommand}"
                            IsEnabled="{Binding Analisando, Converter={StaticResource InverterBool}}"
                            ToolTip="Gera uma pagina HTML para mandar a quem da suporte." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista do Modo Game: o mesmo template das demais paginas -->
        <Border Grid.Row="3" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox ItemsSource="{Binding Itens}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" Padding="6"
                         ItemContainerStyle="{StaticResource ItemDeAcao}"
                         ItemTemplate="{StaticResource TemplateDeActionItem}" />

                <TextBlock Text="Clique em Varrer para ver o que esta aberto."
                           Foreground="{StaticResource TextoSecundario}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding JaVarreu, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />
            </Grid>
        </Border>

        <!-- Rodape: aqui os botoes sao os do Modo Game, nao o "Aplicar N" generico -->
        <Border Grid.Row="4" Margin="0,14,0,0" Padding="0,0,0,18">
            <StackPanel>
                <ProgressBar Height="3" Value="{Binding Progresso}" Maximum="100"
                             Background="{StaticResource Superficie}" Foreground="{StaticResource Acento}"
                             BorderThickness="0" Margin="0,0,0,10"
                             Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Varrer" Style="{StaticResource BotaoBase}"
                            Command="{Binding VarrerCommand}"
                            IsEnabled="{Binding Ocupado, Converter={StaticResource InverterBool}}" />

                    <Button Grid.Column="1" Margin="8,0,0,0" Content="ATIVAR MODO GAME"
                            Style="{StaticResource BotaoPrimario}"
                            Command="{Binding AplicarCommand}" IsEnabled="{Binding PodeAgir}"
                            Visibility="{Binding ModoGameAtivo, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />

                    <Button Grid.Column="1" Margin="8,0,0,0" Content="DESLIGAR MODO GAME"
                            Style="{StaticResource BotaoPrimario}"
                            Command="{Binding ReverterCommand}" IsEnabled="{Binding PodeAgir}"
                            Visibility="{Binding ModoGameAtivo, Converter={StaticResource BoolParaVisibilidade}}" />

                    <CheckBox Grid.Column="2" Margin="16,0,0,0" Content="Simular (nao altera nada)"
                              IsChecked="{Binding DryRun}" VerticalAlignment="Center"
                              ToolTip="Dry-run: produz o mesmo relatorio sem tocar no sistema." />

                    <Button Grid.Column="4" Content="Reverter tudo" Style="{StaticResource BotaoBase}"
                            Command="{Binding ReverterTudoCommand}" IsEnabled="{Binding EhAdministrador}"
                            ToolTip="Desfaz todas as alteracoes de sistema feitas pelo GameBoost." />
                </Grid>

                <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,12,0,0"
                           Visibility="{Binding Resumo, Converter={StaticResource TextoParaVisibilidade}}" />
                <TextBlock Text="{Binding GanhoMedido}" Foreground="{StaticResource Acento}" Margin="0,2,0,0"
                           Visibility="{Binding GanhoMedido, Converter={StaticResource TextoParaVisibilidade}}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextoSecundario}"
                           FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
