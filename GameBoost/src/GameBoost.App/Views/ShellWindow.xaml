<Window x:Class="GameBoost.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameBoost"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fundo}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegacao lateral -->
        <Border Grid.Column="0" Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock Text="GameBoost" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Mostra o que faz e desfaz tudo."
                               Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="14,10,14,14" Padding="10,8"
                        Background="{StaticResource SuperficieAlta}" CornerRadius="6">
                    <TextBlock Text="{Binding AvisoDePrivilegio}" FontSize="11"
                               Foreground="{StaticResource TextoSecundario}" />
                </Border>

                <ListBox ItemsSource="{Binding Paginas}"
                         SelectedItem="{Binding PaginaAtual, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="8,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <!-- Sem isto o leitor de tela anuncia o nome da classe do ViewModel. -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Nome}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitulo}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Caixa" Background="Transparent" CornerRadius="6" Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="Glifo" Grid.Column="0"
                                                           Text="{Binding Icone}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="15" Width="22"
                                                           Foreground="{StaticResource TextoSecundario}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock x:Name="Rotulo" Grid.Column="1"
                                                           Text="{Binding Nome}" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Texto}" />

                                                <!-- Marca discreta nas paginas que ainda nao existem -->
                                                <Ellipse x:Name="Ponto" Grid.Column="2" Width="6" Height="6"
                                                         Fill="{StaticResource TextoDesabilitado}"
                                                         VerticalAlignment="Center" Margin="6,0,2,0"
                                                         Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Implementada}" Value="False">
                                                <Setter TargetName="Rotulo" Property="Foreground" Value="{StaticResource TextoSecundario}" />
                                                <Setter TargetName="Ponto" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource SuperficieAlta}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource SuperficieAlta}" />
                                                <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Acento}" />
                                                <Setter TargetName="Rotulo" Property="Foreground" Value="{StaticResource Texto}" />
                                                <Setter TargetName="Rotulo" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Pagina atual: o DataTemplate certo vem do App.xaml -->
        <ContentControl Grid.Column="1" Content="{Binding PaginaAtual}" Margin="0" />
    </Grid>
</Window>
