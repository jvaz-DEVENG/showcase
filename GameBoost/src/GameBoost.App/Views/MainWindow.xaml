<Window x:Class="GameBoost.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameBoost"
        Height="720" Width="1040"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fundo}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="GameBoost" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Mostra o que faz e desfaz tudo."
                       Foreground="{StaticResource TextoSecundario}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Aviso de restauracao pendente -->
        <Border Grid.Row="1" Background="#33D29922" BorderBrush="{StaticResource RiscoMedio}"
                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding AvisoDeRestauracao, Converter={StaticResource TextoParaVisibilidade}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding AvisoDeRestauracao}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Restaurar agora" Style="{StaticResource BotaoBase}"
                        Command="{Binding ReverterTudoCommand}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Barra de acoes -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Varrer" Style="{StaticResource BotaoBase}"
                    Command="{Binding VarrerCommand}" IsEnabled="{Binding Ocupado, Converter={StaticResource InverterBool}}" />

            <Button Grid.Column="1" Margin="10,0,0,0" Content="ATIVAR MODO GAME"
                    Style="{StaticResource BotaoPrimario}"
                    Command="{Binding AtivarCommand}"
                    IsEnabled="{Binding PodeAgir}"
                    Visibility="{Binding ModoGameAtivo, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />

            <Button Grid.Column="1" Margin="10,0,0,0" Content="DESLIGAR MODO GAME"
                    Style="{StaticResource BotaoPrimario}"
                    Command="{Binding DesligarCommand}"
                    IsEnabled="{Binding PodeAgir}"
                    Visibility="{Binding ModoGameAtivo, Converter={StaticResource BoolParaVisibilidade}}" />

            <CheckBox Grid.Column="2" Margin="16,0,0,0" Content="Simular (nao altera nada)"
                      IsChecked="{Binding DryRun}" ToolTip="Dry-run: produz o mesmo relatorio sem tocar no sistema." />

            <Button Grid.Column="4" Content="Reverter tudo" Style="{StaticResource BotaoBase}"
                    Command="{Binding ReverterTudoCommand}" IsEnabled="{Binding EhAdministrador}"
                    ToolTip="Desfaz todas as alteracoes de sistema feitas pelo GameBoost." />
        </Grid>

        <!-- Lista generica de ActionItem -->
        <Border Grid.Row="3" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                BorderThickness="1" CornerRadius="8">
            <ListBox ItemsSource="{Binding Itens}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch" Padding="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SuperficieAlta}" CornerRadius="6"
                                Padding="12,10" Margin="4,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding Selecionado}"
                                          IsEnabled="{Binding PodeSelecionar}" Margin="0,0,12,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Descricao}"
                                               Foreground="{StaticResource TextoSecundario}" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding GanhoEstimado}" HorizontalAlignment="Right" FontSize="12" />
                                    <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" Margin="0,3,0,0"
                                            Background="{Binding Risco, Converter={StaticResource RiscoParaCor}}">
                                        <TextBlock Text="{Binding TextoDeRisco}" FontSize="11"
                                                   Foreground="#FF0D1117" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="3" Content="?" Width="30" Height="30"
                                        Style="{StaticResource BotaoBase}" Padding="0"
                                        Click="ExplicarItem_Click" Tag="{Binding}"
                                        ToolTip="O que faz, qual o risco, como desfazer" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Rodape -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <ProgressBar Height="3" Value="{Binding Progresso}" Maximum="100"
                         Background="{StaticResource Superficie}" Foreground="{StaticResource Acento}"
                         BorderThickness="0" Margin="0,0,0,10"
                         Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}" />

            <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding GanhoMedido}" Foreground="{StaticResource Acento}" Margin="0,2,0,0"
                       Visibility="{Binding GanhoMedido, Converter={StaticResource TextoParaVisibilidade}}" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextoSecundario}"
                       FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>
