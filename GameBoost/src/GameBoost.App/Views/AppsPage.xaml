<UserControl x:Class="GameBoost.App.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Pagina de aplicativos (secao 5.3), em tres abas. Cada aba tem a sua
      lista e o seu proprio botao de acao: aplicar na aba de atualizacoes
      nao desinstala nada, e vice-versa. Misturar as tres num rodape so
      seria o jeito mais rapido de alguem desinstalar querendo atualizar.
    -->
    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource TextoSecundario}"
                       Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,18">

            <!-- ==================== Instalados ==================== -->
            <TabItem Header="Instalados">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Superficie}" CornerRadius="6"
                                Padding="14,10" Margin="0,0,10,0"
                                Visibility="{Binding Resumo, Converter={StaticResource TextoParaVisibilidade}}">
                            <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Varrer" Style="{StaticResource BotaoBase}"
                                    AutomationProperties.Name="Varrer aplicativos instalados"
                                    Command="{Binding VarrerCommand}"
                                    IsEnabled="{Binding Ocupado, Converter={StaticResource InverterBool}}" />
                            <Button Content="Cancelar" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"
                                    Command="{Binding CancelarCommand}"
                                    Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource Superficie}"
                            BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ListBox ItemsSource="{Binding Itens}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch" Padding="6"
                                     ItemContainerStyle="{StaticResource ItemDeAcao}"
                                     ItemTemplate="{StaticResource TemplateDeActionItem}" />

                            <TextBlock Text="Clique em Varrer para ver o que está instalado."
                                       Foreground="{StaticResource TextoSecundario}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding JaVarreu, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <ProgressBar Height="3" Value="{Binding Progresso}" Maximum="100"
                                     Background="{StaticResource Superficie}" Foreground="{StaticResource Acento}"
                                     BorderThickness="0" Margin="0,0,0,10"
                                     Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{Binding TextoAplicar}"
                                    Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding AplicarCommand}" IsEnabled="{Binding PodeAgir}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="Limpar" Style="{StaticResource BotaoBase}" Padding="10,6"
                                        Command="{Binding DesmarcarTodosCommand}" />
                            </StackPanel>

                            <CheckBox Grid.Column="3" Content="Simular (nao altera nada)" IsChecked="{Binding DryRun}"
                                      VerticalAlignment="Center"
                                      ToolTip="Dry-run: produz o mesmo relatorio sem tocar no sistema." />
                        </Grid>

                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextoSecundario}"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="40" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== Atualizacoes ==================== -->
            <TabItem Header="Atualizações">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Superficie}" CornerRadius="6"
                                Padding="14,10" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ResumoDeAtualizacoes}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <Button Grid.Column="1" Content="Verificar" Style="{StaticResource BotaoBase}"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Verificar atualizacoes"
                                Command="{Binding VerificarAtualizacoesCommand}"
                                IsEnabled="{Binding OcupadoComAtualizacoes, Converter={StaticResource InverterBool}}" />
                    </Grid>

                    <!-- winget ausente: nao adianta lista, o que falta e o proprio winget -->
                    <Border Grid.Row="1" Background="{StaticResource Superficie}"
                            BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8"
                            Padding="16,14" Margin="0,0,0,12"
                            Visibility="{Binding WingetAusente, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel>
                            <TextBlock Text="O winget não está instalado" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,10"
                                       Foreground="{StaticResource TextoSecundario}"
                                       Text="Esta aba usa o winget, o gerenciador de pacotes da própria Microsoft, que vem junto com o App Installer. Ele existe no Windows 10 1709 em diante e no Windows 11; quando falta, é porque foi removido." />
                            <Button Content="Abrir na Microsoft Store" Style="{StaticResource BotaoBase}"
                                    HorizontalAlignment="Left"
                                    Command="{Binding InstalarWingetCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource Superficie}"
                            BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ListBox ItemsSource="{Binding Atualizacoes}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch" Padding="6"
                                     ItemContainerStyle="{StaticResource ItemDeAcao}"
                                     ItemTemplate="{StaticResource TemplateDeActionItem}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <ProgressBar Height="3" Value="{Binding Progresso}" Maximum="100"
                                     Background="{StaticResource Superficie}" Foreground="{StaticResource Acento}"
                                     BorderThickness="0" Margin="0,0,0,10"
                                     Visibility="{Binding OcupadoComAtualizacoes, Converter={StaticResource BoolParaVisibilidade}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{Binding TextoAtualizar}"
                                    Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding AtualizarSelecionadosCommand}"
                                    IsEnabled="{Binding PodeAgir}" />

                            <CheckBox Grid.Column="2" Content="Simular (nao altera nada)" IsChecked="{Binding DryRun}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding StatusDeAtualizacoes}" Foreground="{StaticResource TextoSecundario}"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="52" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== Restos ==================== -->
            <TabItem Header="Restos de apps antigos">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Superficie}" CornerRadius="6"
                                Padding="14,10" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ResumoDeRestos}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <Button Grid.Column="1" Content="Varrer restos" Style="{StaticResource BotaoBase}"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Varrer restos de apps antigos"
                                Command="{Binding VarrerRestosCommand}"
                                IsEnabled="{Binding OcupadoComRestos, Converter={StaticResource InverterBool}}" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource Superficie}"
                            BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8">
                        <ListBox ItemsSource="{Binding Restos}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch" Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding Selecionado}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  AutomationProperties.Name="{Binding Titulo}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Descricao}" FontSize="12"
                                                       Foreground="{StaticResource TextoSecundario}" />
                                            <TextBlock Text="{Binding Caminho}" FontSize="11"
                                                       Foreground="{StaticResource TextoSecundario}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{Binding TextoRemoverRestos}"
                                    Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding RemoverRestosCommand}"
                                    IsEnabled="{Binding PodeAgir}" />
                        </Grid>

                        <TextBlock Text="{Binding StatusDeRestos}" Foreground="{StaticResource TextoSecundario}"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="52" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
