<UserControl x:Class="GameBoost.App.Views.RedePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Pagina de rede (secao 5.9), nos tres blocos que o spec descreve:
      "Velocidade", "Posso jogar online?" (semaforo grande + causas) e
      "Ajustes". A ordem importa: quem abre esta tela veio por causa da
      segunda pergunta, entao ela fica no topo.
    -->
    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource TextoSecundario}"
                           Margin="0,3,12,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Medir" Style="{StaticResource BotaoBase}"
                        AutomationProperties.Name="Medir a rede"
                        Command="{Binding VarrerCommand}"
                        IsEnabled="{Binding Ocupado, Converter={StaticResource InverterBool}}" />
                <Button Content="Cancelar" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"
                        Command="{Binding CancelarCommand}"
                        Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ===== Posso jogar online? ===== -->
                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                        Visibility="{Binding TemNat, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="Posso jogar online?" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="18" Height="18" VerticalAlignment="Center"
                                     Fill="{Binding NatSemaforo, Converter={StaticResource SemaforoParaCor}}" />
                            <TextBlock Text="{Binding Nat}" FontSize="20" FontWeight="Bold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding NatExplicacao}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Causas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"
                                               Foreground="{StaticResource Texto}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextoSecundario}"
                                   Text="As portas de cada jogo e o passo a passo por marca de roteador estão em docs/PORTAS.md. O GameBoost corrige o que é do Windows e não mexe no seu roteador." />
                    </StackPanel>
                </Border>

                <!-- ===== Velocidade ===== -->
                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Velocidade" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Velocidade}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextoSecundario}" />
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                Content="{Binding TextoDoBotaoDeVelocidade}"
                                Style="{StaticResource BotaoBase}"
                                Command="{Binding TestarVelocidadeCommand}"
                                IsEnabled="{Binding MedindoVelocidade, Converter={StaticResource InverterBool}}" />
                    </Grid>
                </Border>

                <!-- ===== Latencia ===== -->
                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                        Visibility="{Binding TemMedicao, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="Latência" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding Pings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Alvo}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Latencia}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Jitter}"
                                                   Foreground="{StaticResource TextoSecundario}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Perda}"
                                                   Foreground="{StaticResource TextoSecundario}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Leitura}"
                                                   Foreground="{StaticResource Acento}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Wifi}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Acento}"
                                   Visibility="{Binding Wifi, Converter={StaticResource TextoParaVisibilidade}}" />

                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextoSecundario}"
                                   Text="Jitter é a variação entre um pacote e o seguinte. É ele, e não a média, que causa a sensação de travada no jogo." />
                    </StackPanel>
                </Border>

                <!-- ===== DNS ===== -->
                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                        Visibility="{Binding TemMedicao, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="Servidores de DNS" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding Dns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Nome}"
                                                   FontWeight="{Binding EmUso, Converter={StaticResource BoolParaPeso}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Endereco}"
                                                   Foreground="{StaticResource TextoSecundario}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Tempo}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding Comparacao}"
                                                   Foreground="{StaticResource TextoSecundario}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextoSecundario}"
                                   Text="DNS rápido faz página abrir mais rápido. Não muda o ping do jogo: o jogo resolve o nome uma vez e depois fala direto com o servidor." />
                    </StackPanel>
                </Border>

                <!-- ===== Quem esta conectado ===== -->
                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                        Visibility="{Binding TemMedicao, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="Quem está falando com a internet agora" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding Conexoes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Processo}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Conexoes}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Destino}"
                                                   Foreground="{StaticResource TextoSecundario}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextoSecundario}"
                                   Text="São conexões abertas, não velocidade. Medir banda por processo exigiria um coletor de eventos rodando o tempo todo, e isso custaria mais CPU do que o problema vale." />
                    </StackPanel>
                </Border>

                <!-- ===== Ajustes ===== -->
                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="8" MinHeight="120">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Itens}" Padding="6"
                                      ItemTemplate="{StaticResource TemplateDeActionItem}" />

                        <TextBlock Text="Clique em Medir para ver a sua rede."
                                   Foreground="{StaticResource TextoSecundario}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding JaVarreu, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=inverter}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodape fixo -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,0,0,18">
            <StackPanel>
                <ProgressBar Height="3" Value="{Binding Progresso}" Maximum="100"
                             Background="{StaticResource Superficie}" Foreground="{StaticResource Acento}"
                             BorderThickness="0" Margin="0,0,0,10"
                             Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{Binding TextoAplicar}"
                            Style="{StaticResource BotaoPrimario}"
                            Command="{Binding AplicarCommand}" IsEnabled="{Binding PodeAgir}" />

                    <Button Grid.Column="1" Content="Reverter" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"
                            Command="{Binding ReverterCommand}" IsEnabled="{Binding PodeAgir}" />

                    <CheckBox Grid.Column="3" Content="Simular (nao altera nada)" IsChecked="{Binding DryRun}"
                              VerticalAlignment="Center"
                              ToolTip="Dry-run: produz o mesmo relatorio sem tocar no sistema." />
                </Grid>

                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextoSecundario}"
                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="52" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
