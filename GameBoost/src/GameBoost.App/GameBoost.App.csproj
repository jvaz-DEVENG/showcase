<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      WinForms entra so pelo NotifyIcon: o WPF nao tem icone de bandeja
      proprio, e a alternativa seria uma dependencia externa so para isso.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GameBoost.App</RootNamespace>
    <AssemblyName>GameBoost</AssemblyName>
    <!-- ReadyToRun reduz o tempo de abertura do single-file (secao 10). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- Main proprio: o modo CLI precisa rodar sem inicializar o WPF. -->
    <StartupObject>GameBoost.App.Program</StartupObject>
  </PropertyGroup>

  <!--
    Elevacao. O padrao e o manifesto de producao (requireAdministrator).
    Passar -p:SemElevacao=true numa build de desenvolvimento troca para o
    manifesto asInvoker, que abre sem UAC no modo somente leitura. Serve para
    rodar e inspecionar o app numa sessao nao elevada.
  -->
  <PropertyGroup>
    <SemElevacao Condition="'$(SemElevacao)' == ''">false</SemElevacao>
    <ApplicationManifest Condition="'$(SemElevacao)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(SemElevacao)' == 'true'">app-dev.manifest</ApplicationManifest>
    <AssemblyName Condition="'$(SemElevacao)' == 'true'">GameBoost-dev</AssemblyName>
  </PropertyGroup>

  <!-- Uma build sem elevacao nunca pode virar release por engano. -->
  <Target Name="ConferirElevacaoNoRelease" BeforeTargets="Build"
          Condition="'$(SemElevacao)' == 'true' AND '$(Configuration)' == 'Release'">
    <Error Text="SemElevacao=true e so para desenvolvimento. O Release precisa do manifesto requireAdministrator." />
  </Target>

  <!--
    WinForms entra so pelo NotifyIcon, mas o SDK dele injeta using global de
    System.Windows.Forms e System.Drawing em TODO arquivo. Isso torna Control,
    Application, Brush e MouseEventArgs ambiguos com os tipos do WPF na
    aplicacao inteira. Os usings saem daqui; o arquivo da bandeja declara os
    dele explicitamente.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameBoost.Core\GameBoost.Core.csproj" />
    <ProjectReference Include="..\GameBoost.Cli\GameBoost.Cli.csproj" />
  </ItemGroup>
</Project>
