<Application x:Class="GameBoost.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameBoost.App.Converters"
             xmlns:vm="clr-namespace:GameBoost.App.ViewModels"
             xmlns:views="clr-namespace:GameBoost.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:RiscoParaCorConverter x:Key="RiscoParaCor" />
            <conv:BoolParaVisibilidadeConverter x:Key="BoolParaVisibilidade" />
            <conv:InverterBoolConverter x:Key="InverterBool" />
            <conv:TextoParaVisibilidadeConverter x:Key="TextoParaVisibilidade" />

            <!--
              Mapeamento pagina -> view. O shell so guarda ViewModels; o WPF
              escolhe a tela. Um modulo novo que herde de ModulePageViewModel
              cai automaticamente no template generico de ModuloPage.
            -->
            <DataTemplate DataType="{x:Type vm:InicioPageViewModel}">
                <views:InicioPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
                <views:PlaceholderPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ConfiguracoesPageViewModel}">
                <views:ConfiguracoesPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ModulePageViewModel}">
                <views:ModuloPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
