<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema escuro padrao, acento unico. Fluent-like, sem gradiente (secao 6). -->
    <Color x:Key="FundoColor">#FF14161A</Color>
    <Color x:Key="SuperficieColor">#FF1C1F26</Color>
    <Color x:Key="SuperficieAltaColor">#FF242830</Color>
    <Color x:Key="AcentoColor">#FF00C2A8</Color>

    <SolidColorBrush x:Key="Fundo" Color="{StaticResource FundoColor}" />
    <SolidColorBrush x:Key="Superficie" Color="{StaticResource SuperficieColor}" />
    <SolidColorBrush x:Key="SuperficieAlta" Color="{StaticResource SuperficieAltaColor}" />
    <SolidColorBrush x:Key="Borda" Color="#FF2E333D" />

    <SolidColorBrush x:Key="Acento" Color="{StaticResource AcentoColor}" />
    <SolidColorBrush x:Key="AcentoEscuro" Color="#FF00947F" />

    <SolidColorBrush x:Key="Texto" Color="#FFEDEFF2" />
    <SolidColorBrush x:Key="TextoSecundario" Color="#FF9AA3B0" />
    <SolidColorBrush x:Key="TextoDesabilitado" Color="#FF5E6672" />

    <!-- Badges de risco: verde, amarelo, vermelho (secao 6). -->
    <SolidColorBrush x:Key="RiscoBaixo" Color="#FF3FB950" />
    <SolidColorBrush x:Key="RiscoMedio" Color="#FFD29922" />
    <SolidColorBrush x:Key="RiscoAlto" Color="#FFF85149" />

    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SuperficieAlta}" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextoDesabilitado}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource Acento}" />
        <Setter Property="Foreground" Value="#FF08121A" />
        <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
