<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Template unico do ActionItem. Toda pagina de modulo usa este mesmo bloco,
      entao a lista da Limpeza, do Desinstalador e da Inicializacao vao sair
      identicas a do Modo Game sem nenhuma tela nova.
    -->

    <Style x:Key="ItemDeAcao" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <DataTemplate x:Key="TemplateDeActionItem">
        <Border Background="{StaticResource SuperficieAlta}" CornerRadius="6" Padding="12,10" Margin="4,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding Selecionado}"
                          IsEnabled="{Binding PodeSelecionar}" Margin="0,0,12,0"
                          ToolTip="{Binding MotivoBloqueio}" />

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                        <Border Background="{StaticResource Borda}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Bloqueado, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Protegido" FontSize="10" Foreground="{StaticResource TextoSecundario}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Descricao}" Foreground="{StaticResource TextoSecundario}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding GanhoEstimado}" HorizontalAlignment="Right" FontSize="12" />
                    <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Background="{Binding Risco, Converter={StaticResource RiscoParaCor}}">
                        <TextBlock Text="{Binding TextoDeRisco}" FontSize="11"
                                   Foreground="#FF0D1117" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="3" Content="?" Width="30" Height="30"
                        Style="{StaticResource BotaoBase}" Padding="0"
                        Command="{Binding ExplicarCommand}"
                        ToolTip="O que faz, qual o risco, como desfazer" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
