<Project>
  <PropertyGroup>
    <!-- Versao semantica unica, propagada para os assemblies e para o Inno Setup. -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <Product>GameBoost</Product>
    <Company>Jonathan Vaz</Company>
    <Authors>Jonathan Vaz</Authors>
    <Copyright>Copyright (c) 2026 Jonathan Vaz</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Trimming quebra WPF e reflexao (secao 10 do spec). Nunca habilitar. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
